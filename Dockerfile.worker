# syntax=docker/dockerfile:1
# Reuses the existing source-pinned compiled Core build, never downloads a floating runtime.
FROM node:22.14.0-bookworm AS build
RUN --mount=type=secret,id=proxy_ca if [ -f /run/secrets/proxy_ca ]; then \
      export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca CURL_CA_BUNDLE=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends python3 build-essential ca-certificates unzip curl git && rm -rf /var/lib/apt/lists/*
RUN --mount=type=secret,id=proxy_ca if [ -f /run/secrets/proxy_ca ]; then \
      export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca CURL_CA_BUNDLE=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca; \
    fi; \
    npm install --global node-gyp@11
WORKDIR /core
COPY scripts ./scripts
COPY upstream ./upstream
COPY patches ./patches
COPY runtime ./runtime
ARG RAILWAY_GIT_COMMIT_SHA
ARG CORE_SOURCE_COMMIT
ENV CORE_SOURCE_COMMIT=${CORE_SOURCE_COMMIT:-${RAILWAY_GIT_COMMIT_SHA}}
RUN --mount=type=secret,id=proxy_ca if [ -f /run/secrets/proxy_ca ]; then \
      export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca CURL_CA_BUNDLE=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca; \
    fi; \
    test -n "$CORE_SOURCE_COMMIT" && ./scripts/build-runtime.sh

FROM node:22.14.0-bookworm-slim AS runtime
# Toolchain for Topic-owned development and governed native/custom tool children.
# No Bot control-plane modules or management credentials. Tailscale state is root-only.
RUN --mount=type=secret,id=proxy_ca if [ -f /run/secrets/proxy_ca ]; then \
      export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca CURL_CA_BUNDLE=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
    tini ca-certificates bash coreutils findutils lsof python3 python3-pip python3-venv \
    git git-lfs build-essential pkg-config libsqlite3-dev libssl-dev zlib1g-dev sqlite3 jq ripgrep fd-find \
    curl wget unzip zip rsync openssh-client gh dnsutils iputils-ping iproute2 \
    procps file tree less ffmpeg imagemagick \
    && git lfs install --system \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/* \
    && groupmod -n core node && usermod -l core -d /nonexistent node
RUN --mount=type=secret,id=proxy_ca if [ -f /run/secrets/proxy_ca ]; then \
      export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca CURL_CA_BUNDLE=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca; \
    fi; \
    npm install --global @playwright/cli@0.1.18 \
    && PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright playwright-cli install-browser chromium --with-deps \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* \
    && chmod -R a+rX,go-w /opt/ms-playwright /usr/local/lib/node_modules
# Scope runner is the same source as Core's embedded runner; root delegation
# does not introduce a second process governor.
COPY runtime/linux/process-scope.c /tmp/process-scope.c
RUN mkdir -p /usr/local/libexec && cc -static -std=c11 -O2 -Wall -Wextra -Werror /tmp/process-scope.c -o /usr/local/libexec/opencode-process-scope \
    && rm /tmp/process-scope.c
# Official immutable release archives, architecture-specific digest verification.
ARG TARGETARCH
RUN --mount=type=secret,id=proxy_ca if [ -f /run/secrets/proxy_ca ]; then \
      export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca CURL_CA_BUNDLE=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca; \
    fi; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
      amd64) digest=108d1d96ecf410d305571e173516f27038f870919a9b89c914a167c6d33a4528 ;; \
      arm64) digest=f60294374967f3dfd8cf57bbbd474d6cfce32d123e3a8ddeab82a87940daa806 ;; \
      *) exit 1 ;; \
    esac; \
    curl -fsSL "https://pkgs.tailscale.com/stable/tailscale_1.104.1_${arch}.tgz" -o /tmp/tailscale.tgz \
    && printf '%s  %s\n' "$digest" /tmp/tailscale.tgz | sha256sum -c - \
    && tar -xzf /tmp/tailscale.tgz -C /tmp \
    && install -m 755 /tmp/tailscale_1.104.1_${arch}/tailscale /tmp/tailscale_1.104.1_${arch}/tailscaled /usr/local/bin/ \
    && rm -rf /tmp/tailscale.tgz /tmp/tailscale_1.104.1_${arch}
COPY --from=build /core/dist/runtime/opencode /usr/local/bin/opencode
COPY --from=build /core/dist/build-info.json /usr/local/share/core-build-info.json
COPY worker /opt/worker
COPY runtime/linux/process-scope.c /opt/worker/process-scope.c
RUN chmod 755 /opt/worker/git_shim.py && ln -s /opt/worker/git_shim.py /usr/local/bin/git
COPY scripts/worker-runtime-smoke.py scripts/worker-runtime-inventory.py /opt/worker-runtime/
ENV OPENCODE_TELEGRAM_PROCESS_BUDGET=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    npm_config_cache=/tmp/npm-cache PIP_CACHE_DIR=/tmp/pip-cache \
    XDG_CACHE_HOME=/tmp/core-cache BUN_INSTALL_CACHE_DIR=/tmp/bun-cache
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "-s", "--"]
CMD ["python3", "-u", "/opt/worker/node_agent.py"]
