+function boundedEnvInt(name: string, fallback: number, min: number, max: number) {
+  const raw = process.env[name]
+  if (!raw) return fallback
+  const parsed = Number.parseInt(raw, 10)
+  if (!Number.isSafeInteger(parsed)) return fallback
+  return Math.min(max, Math.max(min, parsed))
+}
+
+export const TELEGRAM_SUBAGENT_CONCURRENCY = boundedEnvInt("OPENCODE_TELEGRAM_SUBAGENT_CONCURRENCY", 4, 1, 8)
+const TELEGRAM_SUBAGENT_GLOBAL_CONCURRENCY = boundedEnvInt("OPENCODE_TELEGRAM_SUBAGENT_GLOBAL_CONCURRENCY", 6, 1, 16)
+const TELEGRAM_SUBAGENT_MAX_PENDING = boundedEnvInt(
+  "OPENCODE_TELEGRAM_SUBAGENT_MAX_PENDING",
+  24,
+  TELEGRAM_SUBAGENT_CONCURRENCY,
+  128,
+)
+const TELEGRAM_SUBAGENT_TIMEOUT_MS = boundedEnvInt(
+  "OPENCODE_TELEGRAM_SUBAGENT_TIMEOUT_MS",
+  20 * 60 * 1000,
+  30_000,
+  2 * 60 * 60 * 1000,
+)
+
+type SubagentGate = {
+  semaphore: Semaphore.Semaphore
+  pending: number
+}
+
+const globalSubagentSemaphore = Semaphore.makeUnsafe(TELEGRAM_SUBAGENT_GLOBAL_CONCURRENCY)
+const parentSubagentGates = new Map<string, SubagentGate>()
+
+function scheduleSubagent<A, E, R>(parentSessionID: string, self: Effect.Effect<A, E, R>): Effect.Effect<A, E, R> {
+  return Effect.acquireUseRelease(
+    Effect.sync(() => {
+      let gate = parentSubagentGates.get(parentSessionID)
+      if (!gate) {
+        gate = {
+          semaphore: Semaphore.makeUnsafe(TELEGRAM_SUBAGENT_CONCURRENCY),
+          pending: 0,
+        }
+        parentSubagentGates.set(parentSessionID, gate)
+      }
+      if (gate.pending >= TELEGRAM_SUBAGENT_MAX_PENDING) {
+        throw new Error(
+          `Subagent queue is full for parent session ${parentSessionID} (${TELEGRAM_SUBAGENT_MAX_PENDING} pending)`,
+        )
+      }
+      gate.pending += 1
+      return gate
+    }),
+    (gate) => gate.semaphore.withPermit(globalSubagentSemaphore.withPermit(self)),
+    (gate) =>
+      Effect.sync(() => {
+        gate.pending = Math.max(0, gate.pending - 1)
+        if (gate.pending === 0 && parentSubagentGates.get(parentSessionID) === gate) {
+          parentSubagentGates.delete(parentSessionID)
+        }
+      }),
+  )
+}
