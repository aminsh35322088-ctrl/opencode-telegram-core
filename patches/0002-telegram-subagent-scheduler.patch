+// Read only when a test stalls; leave the execution/spawner path untouched.
+function shellProcessSnapshot() {
+  const processes: Array<{ pid: number; parent: number; group: number; state: string }> = []
+  const pending = [process.pid]
+  const visited = new Set<number>()
+  if (process.platform !== "linux") return processes
+  while (pending.length && visited.size < 64) {
+    const parent = pending.shift()!
+    if (visited.has(parent)) continue
+    visited.add(parent)
+    try {
+      const children = readdirSync(`/proc/${parent}/task`).flatMap((thread) => {
+        try {
+          return readFileSync(`/proc/${parent}/task/${thread}/children`, "utf8").trim().split(/\s+/)
+        } catch {
+          return []
+        }
+      })
+      for (const pid of children.map(Number).filter((pid) => pid > 0)) {
+        if (processes.length >= 64) return processes
+        try {
+          const stat = readFileSync(`/proc/${pid}/stat`, "utf8")
+          const fields = stat.slice(stat.lastIndexOf(")") + 2).split(" ")
+          processes.push({ pid, parent, group: Number(fields[2]), state: fields[0]! })
+          pending.push(pid)
+        } catch {
+          /* Process exited during the observation. */
+        }
+      }
+    } catch {
+      /* Parent exited during the observation. */
+    }
+  }
+  return processes
+}
+
+// Diagnostic reads of the locked Effect runtime; never serialize its Context.
+function shellFiberSnapshot(fiber: Fiber.Fiber<unknown, unknown> | undefined, seen = new Set<number>()): unknown {
+  if (!fiber || seen.has(fiber.id) || seen.size >= 32) return undefined
+  seen.add(fiber.id)
+  const runtime = fiber as Fiber.Fiber<unknown, unknown> & {
+    readonly interruptible?: boolean
+    readonly _children?: Set<Fiber.Fiber<unknown, unknown>>
+  }
+  const frames: string[] = []
+  for (let frame = fiber.currentStackFrame; frame && frames.length < 16; frame = frame.parent) frames.push(frame.name)
+  return {
+    id: fiber.id,
+    done: fiber.pollUnsafe() !== undefined,
+    interruptible: runtime.interruptible,
+    frames,
+    children: [...(runtime._children ?? [])].map((child) => shellFiberSnapshot(child, seen)),
+  }
+}
