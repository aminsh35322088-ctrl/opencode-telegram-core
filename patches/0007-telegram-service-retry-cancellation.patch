++    const abort = () => {
++      operation?.stop()
++      cleanup()
++      reject(reason())
++    }
++    if (signal.aborted) {
++      abort()
++      return
++    }
++    signal.addEventListener('abort', abort, { once: true })
++    promiseRetry((retry, attempt, current) => {
++      operation = current
++      if (signal.aborted) {
++        throw reason()
++      }
++      return fn(retry, attempt, current)
++    }, options).then(
++      value => { cleanup(); resolve(value) },
++      error => { cleanup(); reject(error) },
++    )
++  })
++}
