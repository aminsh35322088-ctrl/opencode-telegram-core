+export interface AnonymousModelSpec {
+  readonly id: string
+  readonly name: string
+  readonly family?: string
+  readonly context: number
+  readonly output: number
+  readonly releaseDate?: string
+  readonly temperature: boolean
+  readonly reasoning: boolean
+  readonly toolcall: boolean
+  readonly input: {
+    readonly text: boolean
+    readonly audio: boolean
+    readonly image: boolean
+    readonly video: boolean
+    readonly pdf: boolean
+  }
+  readonly variants?: Record<string, Record<string, unknown>>
+}
+
+export interface AnonymousProviderSpec {
+  readonly id: "kilo" | "ovh"
+  readonly name: string
+  readonly baseURL: string
+  readonly catalogURL: string
+  readonly notice: string
+  readonly fallbackModels: readonly AnonymousModelSpec[]
+  readonly parse: (payload: unknown) => AnonymousModelSpec[]
+}
+
+const textInput = {
+  text: true,
+  audio: false,
+  image: false,
+  video: false,
+  pdf: false,
+} as const
+
+function model(
+  id: string,
+  name: string,
+  context: number,
+  output: number,
+  options: Partial<Omit<AnonymousModelSpec, "id" | "name" | "context" | "output" | "input">> & {
+    input?: Partial<AnonymousModelSpec["input"]>
+  } = {},
+): AnonymousModelSpec {
+  return {
+    id,
+    name,
+    context,
+    output,
+    temperature: options.temperature ?? true,
+    reasoning: options.reasoning ?? false,
+    toolcall: options.toolcall ?? false,
+    input: { ...textInput, ...(options.input ?? {}) },
+    ...(options.family ? { family: options.family } : {}),
+    ...(options.releaseDate ? { releaseDate: options.releaseDate } : {}),
+    ...(options.variants ? { variants: options.variants } : {}),
+  }
+}
+
