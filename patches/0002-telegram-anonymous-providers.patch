+import { expect, test } from "bun:test"
+import {
+  TELEGRAM_ANONYMOUS_PROVIDERS,
+  parseKiloAnonymousModels,
+  parseOvhAnonymousModels,
+} from "@/provider/telegram-anonymous"
+
+test("Kilo parser keeps only free assistant models and maps live capabilities", () => {
+  const models = parseKiloAnonymousModels({
+    data: [
+      {
+        id: "qwen/qwen3.8-27b:free",
+        name: "Qwen 3.8",
+        isFree: true,
+        context_length: 262144,
+        created: 1786722910,
+        architecture: {
+          input_modalities: ["text", "image", "video"],
+          output_modalities: ["text"],
+        },
+        supported_parameters: ["temperature", "reasoning", "reasoning_effort", "tools"],
+        top_provider: { max_completion_tokens: 235929 },
+        opencode: {
+          variants: {
+            high: { reasoning: { effort: "high", enabled: true } },
+          },
+        },
+      },
+      {
+        id: "openrouter/free",
+        name: "OpenRouter Free Models Router",
+        isFree: true,
+        context_length: 200000,
+        architecture: { input_modalities: ["text", "image"], output_modalities: ["text"] },
+        supported_parameters: ["temperature", "reasoning", "tools"],
+        top_provider: { max_completion_tokens: null },
+      },
+      {
+        id: "google/lyria-3-pro-preview",
+        name: "Lyria",
+        isFree: false,
+        context_length: 1048576,
+        architecture: { input_modalities: ["text"], output_modalities: ["text", "audio"] },
+        supported_parameters: ["temperature"],
+        top_provider: { max_completion_tokens: 65536 },
+      },
+      {
+        id: "nvidia/nemotron-3.5-content-safety:free",
+        name: "Content Safety",
+        isFree: true,
+        context_length: 128000,
+        architecture: { input_modalities: ["text", "image"], output_modalities: ["text"] },
+        supported_parameters: ["temperature"],
+        top_provider: { max_completion_tokens: 8192 },
+      },
+    ],
+  })
+
+  expect(models).toHaveLength(2)
+  expect(models[0].id).toBe("qwen/qwen3.8-27b:free")
+  expect(models[0].toolcall).toBe(true)
+  expect(models[0].reasoning).toBe(true)
+  expect(models[0].input.image).toBe(true)
+  expect(models[0].input.video).toBe(true)
+  expect(models[0].variants?.high).toEqual({ reasoning: { effort: "high", enabled: true } })
+  expect(models[1].id).toBe("openrouter/free")
+  expect(models[1].output).toBe(32_768)
+})
+
+test("OVH parser excludes non-chat and guard models and stays conservative", () => {
+  const models = parseOvhAnonymousModels({
+    data: [
+      {
+        id: "gpt-oss-120b",
+        created: 1756386145,
+        context_length: 131072,
+        max_completion_tokens: 131072,
+      },
+      {
+        id: "Qwen2.5-VL-72B-Instruct",
+        created: 1743423983,
+        context_length: 32768,
+        max_completion_tokens: 32768,
+      },
+      {
+        id: "Qwen3Guard-Gen-8B",
+        context_length: 32768,
+        max_completion_tokens: 16384,
+      },
+      {
+        id: "Qwen3-Embedding-8B",
+        context_length: 32768,
+        max_completion_tokens: 0,
+      },
+    ],
+  })
+
+  expect(models.map((item) => item.id)).toEqual(["gpt-oss-120b", "Qwen2.5-VL-72B-Instruct"])
+  expect(models[0].toolcall).toBe(true)
+  expect(models[0].reasoning).toBe(true)
+  expect(models[1].toolcall).toBe(false)
+  expect(models[1].input.image).toBe(true)
+})
+
+test("anonymous providers ship credential-free fallback catalogs", () => {
+  const kilo = TELEGRAM_ANONYMOUS_PROVIDERS.find((item) => item.id === "kilo")
+  const ovh = TELEGRAM_ANONYMOUS_PROVIDERS.find((item) => item.id === "ovh")
+
+  expect(kilo?.baseURL).toBe("https://api.kilo.ai/api/gateway")
+  expect(kilo?.fallbackModels.some((item) => item.id === "kilo-auto/free")).toBe(true)
+  expect(kilo?.fallbackModels.some((item) => item.id === "qwen/qwen3.8-27b:free")).toBe(true)
+
+  expect(ovh?.baseURL).toBe("https://oai.endpoints.kepler.ai.cloud.ovh.net/v1")
+  expect(ovh?.fallbackModels.some((item) => item.id === "gpt-oss-120b")).toBe(true)
+  expect(ovh?.fallbackModels.some((item) => item.id === "Qwen3.8-27B")).toBe(true)
+})
