+  model("Mistral-7B-Instruct-v0.3", "Mistral 7B Instruct v0.3", 65_536, 65_536),
+  model("Qwen2.5-VL-72B-Instruct", "Qwen2.5 VL 72B Instruct", 32_768, 32_768, {
+    input: { image: true },
+  }),
+  model("Mistral-Nemo-Instruct-2407", "Mistral Nemo Instruct 2407", 65_536, 65_536),
+  model("gpt-oss-20b", "GPT-OSS 20B", 131_072, 131_072, { reasoning: true, toolcall: true }),
+]
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value)
+}
+
+function records(value: unknown): Record<string, unknown>[] {
+  return Array.isArray(value) ? value.filter(isRecord) : []
+}
+
+function strings(value: unknown): string[] {
+  return Array.isArray(value) ? value.filter((item): item is string => typeof item === "string") : []
+}
+
+function number(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : undefined
+}
+
+function dateFromUnix(value: unknown): string | undefined {
+  const seconds = number(value)
+  if (!seconds) return undefined
+  return new Date(seconds * 1000).toISOString().slice(0, 10)
+}
+
+function safeVariants(value: unknown): Record<string, Record<string, unknown>> | undefined {
+  if (!isRecord(value)) return undefined
+  const out: Record<string, Record<string, unknown>> = {}
+  for (const [key, item] of Object.entries(value)) {
+    if (isRecord(item)) out[key] = item
+  }
+  return Object.keys(out).length ? out : undefined
+}
+
+function excludedAssistantModel(id: string, name: string) {
+  return /(guard|safety|moderation|embedding|rerank)/i.test(id + " " + name)
+}
+
+export function parseKiloAnonymousModels(payload: unknown): AnonymousModelSpec[] {
+  if (!isRecord(payload)) return []
+  const result: AnonymousModelSpec[] = []
+
+  for (const item of records(payload.data)) {
+    const id = typeof item.id === "string" ? item.id : ""
+    const name = typeof item.name === "string" ? item.name : id
+    if (!id || item.isFree !== true || excludedAssistantModel(id, name)) continue
+
+    const architecture = isRecord(item.architecture) ? item.architecture : {}
+    const outputs = strings(architecture.output_modalities)
+    if (outputs.length > 0 && !outputs.includes("text")) continue
+
+    const context = number(item.context_length)
+    const top = isRecord(item.top_provider) ? item.top_provider : {}
+    const output = number(top.max_completion_tokens) ?? (context ? Math.min(context, 32_768) : undefined)
+    if (!context || !output) continue
+
+    const params = new Set(strings(item.supported_parameters))
+    const inputs = strings(architecture.input_modalities)
+    const opencode = isRecord(item.opencode) ? item.opencode : {}
+    result.push(
+      model(id, name, context, output, {
+        releaseDate: dateFromUnix(item.created),
+        temperature: params.has("temperature"),
+        reasoning: params.has("reasoning") || params.has("reasoning_effort"),
+        toolcall: params.has("tools"),
+        input: {
+          text: inputs.length === 0 || inputs.includes("text"),
+          image: inputs.includes("image"),
+          audio: inputs.includes("audio"),
+          video: inputs.includes("video"),
+        },
+        variants: safeVariants(opencode.variants),
+      }),
+    )
+  }
+
+  return result
+}
+
+function ovhToolCall(id: string) {
+  return (
+    /^Qwen3(?!Guard)/i.test(id) ||
+    /^gpt-oss-/i.test(id) ||
+    /^Meta-Llama-3_3-/i.test(id) ||
+    /^Mistral-Small-/i.test(id)
+  )
+}
+
+function ovhReasoning(id: string) {
+  return /^Qwen3(?!Guard)/i.test(id) || /^gpt-oss-/i.test(id)
+}
+
+export function parseOvhAnonymousModels(payload: unknown): AnonymousModelSpec[] {
+  if (!isRecord(payload)) return []
+  const result: AnonymousModelSpec[] = []
+
+  for (const item of records(payload.data)) {
+    const id = typeof item.id === "string" ? item.id : ""
+    if (!id || excludedAssistantModel(id, id)) continue
+    const context = number(item.context_length)
+    const output = number(item.max_completion_tokens)
+    if (!context || !output) continue
+
+    result.push(
+      model(id, id, context, output, {
+        releaseDate: dateFromUnix(item.created),
+        reasoning: ovhReasoning(id),
+        toolcall: ovhToolCall(id),
+        input: {
+          image: /^Qwen2\.5-VL-/i.test(id),
+        },
+      }),
+    )
+  }
+
+  return result
+}
+
+export const TELEGRAM_ANONYMOUS_PROVIDERS: readonly AnonymousProviderSpec[] = [
+  {
+    id: "kilo",
+    name: "Kilo Gateway (Anonymous)",
+    baseURL: "https://api.kilo.ai/api/gateway",
+    catalogURL: "https://api.kilo.ai/api/gateway/models",
+    notice:
+      "Anonymous free routes are rate limited per IP. Kilo and upstream providers may log prompts/outputs for model improvement; do not use sensitive data.",
+    fallbackModels: KILO_FALLBACK,
+    parse: parseKiloAnonymousModels,
+  },
+  {
+    id: "ovh",
+    name: "OVHcloud AI Endpoints (Anonymous)",
+    baseURL: "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1",
+    catalogURL: "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1/models",
+    notice: "Anonymous access is intentionally low-throughput and intended as a fallback tier.",
+    fallbackModels: OVH_FALLBACK,
+    parse: parseOvhAnonymousModels,
+  },
+]
+
+export async function discoverAnonymousModels(provider: AnonymousProviderSpec): Promise<AnonymousModelSpec[]> {
+  const response = await fetch(provider.catalogURL, {
+    headers: {
+      Accept: "application/json",
+      "User-Agent": "opencode-telegram-core/anonymous-provider-discovery",
+    },
+    signal: AbortSignal.timeout(5_000),
+  })
+  if (!response.ok) throw new Error(`${provider.id} anonymous model discovery failed: HTTP ${response.status}`)
+  return provider.parse(await response.json())
+}
