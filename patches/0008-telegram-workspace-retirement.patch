+import type { InstanceContext } from "@/project/instance-context"
+
 const disposers = new Set<(directory: string) => Promise<void>>()
+const retirements = new Map<string, Promise<void>>()
+const retiredContexts = new WeakSet<InstanceContext>()
+const contexts = new Map<string, Set<InstanceContext>>()
 
 export function registerDisposer(disposer: (directory: string) => Promise<void>) {
   disposers.add(disposer)
-  return () => {
-    disposers.delete(disposer)
-  }
+  return () => { disposers.delete(disposer) }
+}
+
+export function registerContext(ctx: InstanceContext) {
+  assertContextActive(ctx)
+  let owned = contexts.get(ctx.directory)
+  if (!owned) { owned = new Set(); contexts.set(ctx.directory, owned) }
+  owned.add(ctx)
+}
+
+export function retireContext(ctx: InstanceContext) {
+  retiredContexts.add(ctx)
+}
+
+export function assertDirectoryAvailable(directory: string) {
+  if (retirements.has(directory)) throw new Error("Workspace retirement is pending or uncertain")
+}
+
+export function isContextActive(ctx: InstanceContext) {
+  return !retiredContexts.has(ctx) && !retirements.has(ctx.directory)
+}
+
+export function assertContextActive(ctx: InstanceContext) {
+  if (retiredContexts.has(ctx)) throw new Error("Workspace context has retired")
+  assertDirectoryAvailable(ctx.directory)
+}
+
+export function hasUnsettledRetirement(directory: string) {
+  return retirements.has(directory)
 }
 
-export async function disposeInstance(directory: string) {
-  await Promise.allSettled([...disposers].map((disposer) => disposer(directory)))
+export function disposeInstance(directory: string): Promise<void> {
+  const previous = retirements.get(directory)
+  if (previous) return previous
+  for (const ctx of contexts.get(directory) ?? []) retireContext(ctx)
+  contexts.delete(directory)
+  // Register the fence before invoking any disposer. A rejected retirement stays
+  // quarantined: invalidated service caches cannot safely retry uncertain cleanup.
+  const retirement = Promise.resolve().then(async () => {
+    const exits = await Promise.allSettled([...disposers].map(disposer => Promise.resolve().then(() => disposer(directory))))
+    const failures = exits.filter((exit): exit is PromiseRejectedResult => exit.status === "rejected")
+    if (failures.length) throw new AggregateError(failures.map(exit => exit.reason), "Workspace cleanup failed")
+    if (retirements.get(directory) === retirement) retirements.delete(directory)
+  })
+  retirements.set(directory, retirement)
+  return retirement
 }
