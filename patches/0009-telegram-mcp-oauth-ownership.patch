+
+// Ownership can retire while the file lock is held across asynchronous I/O.
+test("credential mutation rechecks retirement inside the file lock after reading", async () => {
+  const file = authFile()
+  await Effect.runPromise(Effect.gen(function* () {
+    const auth = yield* authService(file.fsLayer)
+    yield* auth.updateTokens("owned", { accessToken: "original" }, "https://example.test/mcp")
+    let entered!: () => void; let release!: () => void; let active = true
+    const observed = new Promise<void>(resolve => { entered = resolve })
+    const gate = new Promise<void>(resolve => { release = resolve })
+    file.blockRead(gate, entered)
+    const mutation = yield* auth.updateTokens("owned", { accessToken: "late" }, "https://example.test/mcp", () => {
+      if (!active) throw new Error("owner retired")
+    }).pipe(Effect.forkChild)
+    yield* Effect.promise(() => observed)
+    active = false; release()
+    expect(Exit.isFailure(yield* Fiber.await(mutation))).toBe(true)
+    expect((yield* auth.get("owned"))?.tokens?.accessToken).toBe("original")
+  }))
+})
