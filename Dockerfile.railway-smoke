FROM oven/bun:1.3.14

WORKDIR /app

COPY runtime/package.json runtime/bun.lock ./runtime/
RUN cd runtime && bun install --frozen-lockfile

COPY runtime ./runtime

RUN cd runtime && bun run check
RUN cd runtime && bun build src/smoke-server.ts --target=bun --format=esm --minify --outfile=/app/smoke-server.js

ENV PORT=3000
EXPOSE 3000

CMD ["bun", "/app/smoke-server.js"]
